rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /profiles/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /vehicles/{driverId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(driverId);
    }

    match /licenses/{driverId}/{allPaths=**} {
      allow read, write: if isOwner(driverId);
    }

    match /driver_licenses/{driverId}/{allPaths=**} {
      allow read, write: if isOwner(driverId);
    }

    match /verifications/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}