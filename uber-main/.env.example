# VARLIFE Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Google Maps (used by app.config.js for native maps)
EXPO_PUBLIC_GOOGLE_MAPS_APIKEY=

# Firebase (Web app from project varlife-4eeeb)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=varlife-4eeeb.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=varlife-4eeeb
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=varlife-4eeeb.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Veriff — keep false until Cloud Functions are deployed for production
EXPO_PUBLIC_VERIFF_ENABLED=false

# Yoco test checkout proxy (see scripts/yoco-checkout-server.mjs)
EXPO_PUBLIC_YOCO_CHECKOUT_URL=http://127.0.0.1:8787/checkout
# YOCO_SECRET_KEY is ONLY for the local proxy / server — never EXPO_PUBLIC_
# YOCO_SECRET_KEY=sk_test_...