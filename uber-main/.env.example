# VARLIFE Environment Variables
# Copy to .env and fill in values. Never commit .env to source control.

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_APIKEY=

# Stripe (optional)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=varlife-4eeeb.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=varlife-4eeeb
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=varlife-4eeeb.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Veriff — set on Supabase Edge Functions only (NOT in client code)
# Option A: Supabase Dashboard → Project Settings → Edge Functions → Secrets
# Option B: npx supabase secrets set VERIFF_API_KEY=... VERIFF_SHARED_SECRET=... --project-ref gksfzvbfvnimrujrckwo
# Option C: node scripts/setup-veriff-secrets.js (stores in Vault; redeploy functions after)
# VERIFF_API_KEY=
# VERIFF_SHARED_SECRET=
