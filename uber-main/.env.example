# VARLIFE Environment Variables
# Copy to .env and fill in values. Never commit .env to source control.
# See FIREBASE_SETUP.md for where to copy Firebase values.

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_APIKEY=

# Stripe (optional)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Firebase Configuration (required — Web app from project varlife-4eeeb)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=varlife-4eeeb.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=varlife-4eeeb
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=varlife-4eeeb.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Must be the real Web appId from Firebase Console (not a placeholder like ...abcd...)
EXPO_PUBLIC_FIREBASE_APP_ID=

# Veriff — keep secrets off the client. Prefer Firebase Cloud Functions / server secrets.
# VERIFF_API_KEY=
# VERIFF_SHARED_SECRET=
