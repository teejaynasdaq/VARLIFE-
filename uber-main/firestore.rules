rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isRideParticipant() {
      return isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.rider_id == request.auth.uid ||
        resource.data.driver_id == request.auth.uid ||
        request.resource.data.driver_id == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /drivers/{driverId} {
      allow read: if true;
      allow create, update: if isOwner(driverId);
      allow delete: if false;
    }

    match /rides/{rideId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (request.resource.data.user_id == request.auth.uid ||
         request.resource.data.rider_id == request.auth.uid);
      allow update: if isRideParticipant();
      allow delete: if false;
    }

    match /ride_negotiations/{negId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sender_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /vehicle_details/{driverId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(driverId);
      allow delete: if false;
    }

    match /bank_details/{driverId} {
      allow read, write: if isOwner(driverId);
    }

    match /payshap_details/{driverId} {
      allow read, write: if isOwner(driverId);
    }

    match /emergency_contacts/{contactId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow update: if false;
    }

    match /ride_ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.rater_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /saved_locations/{locationId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow update: if false;
    }

    match /lost_item_reports/{reportId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /student_verifications/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /student_offers/{offerId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /student_saved_offers/{docId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow update: if false;
    }

    match /safety_logs/{logId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
